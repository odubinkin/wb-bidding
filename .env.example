# Account settings are operator-provisioned and immutable after first binding.
ACCOUNT_CURRENCY=RUB
ACCOUNT_TIMEZONE=Europe/Moscow

# Replace every placeholder before starting a real deployment.
ADMIN_API_SERVICE_TOKEN=replace-with-at-least-32-characters
DATABASE_URL=postgresql://wb_bidder:replace-me@localhost:5432/wb_bidder
POSTGRES_PASSWORD=replace-me

PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
SCHEDULER_ENABLED=true

# Safe production defaults: official host and writes disabled.
WB_API_MODE=prod
WB_API_PROD_BASE_URL=https://advert-api.wildberries.ru
WB_API_SANDBOX_BASE_URL=https://advert-api-sandbox.wildberries.ru
WB_API_MOCK_BASE_URL=http://localhost:3001
WB_API_TOKEN=replace-with-secret-reference
WB_EXPECTED_TOKEN_TYPE=PERSONAL
WB_API_WRITE_ENABLED=false
WB_PRODUCTION_WRITE_CONFIRMATION=
WB_ENDPOINT_PROFILE_VERSION=wb-promotion-2026-07-28-v1

# Deterministic mock-only settings.
MOCK_CLOCK_MODE=virtual
MOCK_INITIAL_TIME=2026-07-28T00:00:00.000Z
MOCK_SEED=foundation
