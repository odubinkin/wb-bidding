# Account settings are operator-provisioned and immutable after first binding.
ACCOUNT_CURRENCY=RUB
ACCOUNT_TIMEZONE=Europe/Moscow

# Replace every placeholder before starting a real deployment.
ADMIN_API_SERVICE_TOKEN=replace-with-at-least-32-characters
DATABASE_URL=postgresql://wb_bidder:replace-me@localhost:5432/wb_bidder
POSTGRES_PASSWORD=replace-me

PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
SCHEDULER_ENABLED=true
CURRENT_STATE_SYNC_CRON=5 */15 * * * *
CURRENT_STATE_SYNC_RUN_DEADLINE_MS=600000
CURRENT_STATE_TARGET_SYNC_SLA_MINUTES=20
CURRENT_BID_FRESHNESS_MINUTES=20
DATA_SYNC_CRON=25 */30 * * * *
DECISION_CRON=45 */30 * * * *
CAMPAIGN_APPLY_CRON=*/10 * * * * *
VERIFICATION_POLL_INTERVAL_MS=30000
RECONCILIATION_CRON=15 * * * * *
BID_VERIFICATION_INITIAL_DELAY_MS=30000
BID_VERIFICATION_TIMEOUT_MS=600000
RECONCILIATION_STABLE_OLD_STATE_READS=2
RECONCILIATION_STABLE_READ_INTERVAL_MS=30000
RECONCILIATION_MAX_WRITE_ATTEMPTS=2
WB_WRITE_PRE_BYTE_MAX_RETRIES=1
PRE_WRITE_STATE_MAX_AGE_MS=10000
MAX_DECISION_AGE_MINUTES=60
WB_WRITE_ATTEMPT_RETENTION_DAYS=30
MINIMUM_BID_TARGET_SYNC_SLA_MINUTES=720
MINIMUM_BID_FRESHNESS_MINUTES=720
SYNC_PAGE_SIZE=500
BID_STATE_MAX_OBSERVATION_GAP_MINUTES=20
DAY_FINALIZATION_MIN_STABLE_READS=2
DAY_FINALIZATION_MIN_STABLE_MINUTES=60
CONVERSION_LAG_DAYS=1
EXTERNAL_WRITE_CONTROL_MODE=SHARED

# Safe production defaults: official host and writes disabled.
WB_API_MODE=prod
WB_API_PROD_BASE_URL=https://advert-api.wildberries.ru
WB_API_SANDBOX_BASE_URL=https://advert-api-sandbox.wildberries.ru
WB_API_MOCK_BASE_URL=http://localhost:3001
WB_API_CONNECT_TIMEOUT_MS=2000
WB_API_TIMEOUT_MS=15000
WB_API_GLOBAL_RATE_LIMIT_REQUESTS=5
WB_API_GLOBAL_RATE_LIMIT_INTERVAL_MS=1000
WB_API_GLOBAL_RATE_LIMIT_BURST=5
WB_API_RATE_LIMITS_JSON={}
WB_API_MAX_IN_FLIGHT=5
WB_READ_MAX_ATTEMPTS=3
WB_READ_RETRY_BASE_MS=250
WB_READ_RETRY_CAP_MS=5000
WB_VERIFY_HTTP_MAX_ATTEMPTS=2
WB_TOKEN_EXPIRY_WARN_DAYS=14
WB_API_TOKEN=replace-with-secret-reference
WB_EXPECTED_TOKEN_TYPE=PERSONAL
WB_API_WRITE_ENABLED=false
WB_PRODUCTION_WRITE_CONFIRMATION=
WB_ENDPOINT_PROFILE_VERSION=wb-promotion-2026-07-28-v1

# Deterministic mock-only settings.
MOCK_CLOCK_MODE=virtual
MOCK_INITIAL_TIME=2026-07-28T00:00:00.000Z
MOCK_SEED=foundation
