{
  "name": "wb-bidder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented backend for deterministic Wildberries Promotion bid management.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "dev:bidder": "pnpm --filter @wb-bidder/bidder dev",
    "dev:mock": "pnpm --filter @wb-bidder/wb-mock dev",
    "start:bidder": "pnpm --filter @wb-bidder/bidder start",
    "start:mock": "pnpm --filter @wb-bidder/wb-mock start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --coverage",
    "test:openapi": "vitest run tests/openapi",
    "test:integration": "node scripts/require-database-url.mjs integration && vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:e2e": "node scripts/require-database-url.mjs e2e && vitest run tests/e2e --passWithNoTests",
    "test:golden": "vitest run tests/golden",
    "test:property": "vitest run tests/property",
    "test:mutation": "vitest run tests/mutation && node scripts/run-decision-mutation-tests.mjs",
    "test:load": "node scripts/require-database-url.mjs load && vitest run tests/load --passWithNoTests",
    "test:load-sync": "vitest run tests/load/sync-capacity.load.spec.ts",
    "test:runbook": "node scripts/require-database-url.mjs runbook && vitest run tests/runbook tests/unit/wb-api.spec.ts tests/integration/write-pipeline.integration.spec.ts",
    "test:mock-openapi": "vitest run tests/openapi",
    "prisma:generate": "DATABASE_URL=postgresql://validation:validation@localhost:5432/validation prisma generate",
    "prisma:validate": "DATABASE_URL=postgresql://validation:validation@localhost:5432/validation prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:verify": "prisma migrate deploy && prisma migrate status",
    "profile:checksum": "node scripts/verify-endpoint-profile.mjs",
    "verify:deprecated-endpoints": "node scripts/verify-deprecated-endpoints.mjs",
    "verify:database-architecture": "node scripts/verify-database-architecture.mjs",
    "verify:wb-contract-fixtures": "node scripts/verify-wb-contract-fixtures.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "security:secrets": "node scripts/verify-secrets.mjs",
    "security:container": "node scripts/verify-container.mjs",
    "scripts:check": "node --check scripts/sandbox-smoke.mjs && node --check scripts/compose-smoke.mjs && node --check scripts/smoke-built-apps.mjs && node --check scripts/verify-docs.mjs && node --check scripts/verify-secrets.mjs && node --check scripts/verify-container.mjs && node --check scripts/verify-database-architecture.mjs && node --check scripts/require-database-url.mjs",
    "security:scan": "pnpm audit --audit-level=high",
    "smoke:built": "node scripts/smoke-built-apps.mjs",
    "smoke:compose": "node scripts/compose-smoke.mjs",
    "smoke:sandbox": "node scripts/sandbox-smoke.mjs",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run scripts:check && pnpm run verify:database-architecture && pnpm run test:unit && pnpm run test:golden && pnpm run test:openapi && pnpm run test:contract && pnpm run prisma:validate && pnpm run profile:checksum && pnpm run verify:wb-contract-fixtures && pnpm run verify:deprecated-endpoints"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "canonicalize": "3.0.0",
    "decimal.js": "10.6.0",
    "jose": "6.1.2",
    "nestjs-pino": "4.6.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/supertest": "6.0.3",
    "@swc/core": "1.15.46",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "63.3.2",
    "dotenv": "17.2.3",
    "globals": "17.3.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "rimraf": "6.0.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/swagger>js-yaml": "4.3.0",
      "esbuild": "0.28.1",
      "minimatch": "10.2.6"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
