{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "prisma.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist", "generated", "node_modules", "prisma/migrations"]
}
