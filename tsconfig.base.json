{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@wb-bidder/config": ["packages/config/src/index.ts"],
      "@wb-bidder/contracts": ["packages/contracts/src/index.ts"],
      "@wb-bidder/data-sync": ["packages/data-sync/src/index.ts"],
      "@wb-bidder/decision-engine": ["packages/decision-engine/src/index.ts"],
      "@wb-bidder/wb-api": ["packages/wb-api/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2024",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  }
}
